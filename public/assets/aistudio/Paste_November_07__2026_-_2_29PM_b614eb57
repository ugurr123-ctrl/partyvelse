        labelDelta.textContent = 'BAĞLI %100 // KİLİTLENDİ';
        labelDelta.className = 'font-label-status text-label-status text-primary mt-0.5 font-bold';
        patchbayStatus.textContent = '4/4 PIN AKTİF (OPTİMAL)';
        patchbayStatus.className = 'font-label-telemetry text-label-telemetry text-primary-container bg-surface-container-highest px-2 py-0.5 rounded-lg';
