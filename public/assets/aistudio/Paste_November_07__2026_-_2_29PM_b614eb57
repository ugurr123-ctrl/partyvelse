  function updateVoltageDisplay() {
    const display = document.getElementById('voltage-display');
    const slider = document.getElementById('voltage-slider');
    const radial = document.getElementById('radial-progress');
    
    if (display) display.textContent = currentVoltage.toFixed(1);
    if (slider) slider.value = currentVoltage;

    // SVG radial dash calculation (range 12 to 36)
    const normalized = (currentVoltage - 12) / (36 - 12);
    const maxOffset = 125.6;
    const currentOffset = maxOffset - (normalized * maxOffset);
    if (radial) radial.style.strokeDashoffset = currentOffset;
  }

  function adjustVoltage(delta) {
    currentVoltage = Math.min(36, Math.max(12, currentVoltage + delta));
    updateVoltageDisplay();
  }

  function onSliderChange(val) {
    currentVoltage = parseFloat(val);
    updateVoltageDisplay();
  }

  function executeIntervention() {
    if (!isDeltaConnected) {
      alert('DİKKAT: PORT-DELTA soketi henüz Sarı kablo ile bağlanmadı!');
      return;
