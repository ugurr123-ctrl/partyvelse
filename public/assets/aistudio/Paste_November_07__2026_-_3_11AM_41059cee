<span>Aynı Mürettebatla Yeniden Dal</span>
</button>
<!-- Secondary Telemetry / Lobby Button -->
<button class="w-full h-12 bg-surface-container-high/80 text-secondary hover:bg-surface-bright font-headline-sm text-headline-sm rounded-lg flex items-center justify-center gap-space-xs active:scale-[0.98] transition-all cursor-pointer" id="lobby-btn" type="button">
<span class="material-symbols-outlined text-[20px]">chevron_left</span>
<span>Lobiye Dön</span>
</button>
</div>
</div>
</div>
<script>
  // Interactive micro-feedback for victory screen buttons
  const playAgain = document.getElementById('play-again-btn');
  const lobbyBtn = document.getElementById('lobby-btn');

  if (playAgain) {
    playAgain.addEventListener('click', () => {
      playAgain.classList.add('scale-95');
      setTimeout(() => {
        playAgain.classList.remove('scale-95');
        // Action dispatched for re-queueing crew
      }, 150);
    });
  }

  if (lobbyBtn) {
    lobbyBtn.addEventListener('click', () => {
      lobbyBtn.classList.add('opacity-70');
      setTimeout(() => {
        lobbyBtn.classList.remove('opacity-70');
      }, 150);
    });
  }
</script></main></body></html>