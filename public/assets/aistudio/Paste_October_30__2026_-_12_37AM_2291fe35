  (function initVictoryCelebration() {
    const canvas = document.getElementById('stardust-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let width, height;
    let particles = [];

    function resize() {
      width = canvas.width = canvas.parentElement.clientWidth;
      height = canvas.height = canvas.parentElement.clientHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    const colors = ['#FFB703', '#FFDBA0', '#00EEFC', '#D3FBFF', '#DAB5FF'];

    for (let i = 0; i < 42; i++) {
      particles.push({
        x: Math.random() * (width || 360),
        y: Math.random() * (height || 700),
        size: Math.random() * 2.2 + 0.8,
        speedX: (Math.random() - 0.5) * 0.4,
        speedY: -Math.random() * 0.7 - 0.2,
        color: colors[Math.floor(Math.random() * colors.length)],
        alpha: Math.random() * 0.7 + 0.3,
        pulse: Math.random() * 0.05 + 0.01,
      });
    }

    function animate() {
      ctx.clearRect(0, 0, width, height);
      for (let p of particles) {
        p.y += p.speedY;
        p.x += p.speedX;
        p.alpha += Math.sin(Date.now() * 0.003 + p.size) * 0.01;

        if (p.y < 0) {
          p.y = height + 10;
          p.x = Math.random() * width;
        }

        ctx.save();
        ctx.globalAlpha = Math.max(0.1, Math.min(0.9, p.alpha));
        ctx.fillStyle = p.color;
        ctx.shadowBlur = 8;
        ctx.shadowColor = p.color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
      requestAnimationFrame(animate);
    }
    requestAnimationFrame(animate);

    // Replay button tactile rotation micro-interaction
    const replayBtn = document.getElementById('btn-replay');
    const replayIcon = document.getElementById('replay-icon');
    if (replayBtn && replayIcon) {
      let degree = 0;
      replayBtn.addEventListener('click', () => {
        degree += 360;
        replayIcon.style.transform = `rotate(${degree}deg)`;
      });
    }
  })();
</script></main></body></html>

