<script>
  (function() {
    // 1. Rotary Valve Dial Logic
    const dialContainer = document.getElementById('rotaryDialContainer');
    const dialKnob = document.getElementById('rotaryDialKnob');
    const dialText = document.getElementById('dialStateText');
    const dialLevels = [
      { deg: 0, text: '%50 DENGEDE' },
      { deg: 90, text: '%75 BASINÇLI' },
      { deg: 180, text: '%100 TAHLİYE' },
      { deg: 270, text: '%25 DÜŞÜK' }
    ];
    let dialIndex = 0;

    if (dialContainer && dialKnob && dialText) {
      dialContainer.addEventListener('click', function() {
        dialIndex = (dialIndex + 1) % dialLevels.length;
        dialKnob.style.transform = 'rotate(' + dialLevels[dialIndex].deg + 'deg)';
        dialText.innerText = dialLevels[dialIndex].text;
      });
    }

    // 2. Mechanical Seal Lever Logic
    const leverTrack = document.getElementById('leverTrack');
    const leverHandle = document.getElementById('leverHandle');
    const sealStateBadge = document.getElementById('sealStateBadge');
    const sealStatusIcon = document.getElementById('sealStatusIcon');
    let isLocked = true;

    if (leverTrack && leverHandle && sealStateBadge && sealStatusIcon) {
      leverTrack.addEventListener('click', function() {
        isLocked = !isLocked;
        if (isLocked) {
          leverHandle.style.transform = 'translateY(0px)';
          leverHandle.className = 'w-11 h-11 rounded-full bg-primary-container shadow-2xl flex items-center justify-center transition-all duration-200';
          sealStateBadge.innerText = 'KİLİTLİ';
          sealStateBadge.className = 'font-label-telemetry text-label-telemetry text-primary-container font-bold';
          sealStatusIcon.innerText = 'lock';
          sealStatusIcon.className = 'material-symbols-outlined text-primary-container text-[16px]';
        } else {
          leverHandle.style.transform = 'translateY(56px)';
          leverHandle.className = 'w-11 h-11 rounded-full bg-secondary-fixed-dim shadow-2xl flex items-center justify-center transition-all duration-200';
          sealStateBadge.innerText = 'DEVRE DIŞI';
          sealStateBadge.className = 'font-label-telemetry text-label-telemetry text-secondary-fixed-dim font-bold';
          sealStatusIcon.innerText = 'lock_open';
          sealStatusIcon.className = 'material-symbols-outlined text-secondary-fixed-dim text-[16px]';
        }
      });
    }

    // 3. Vacuum Pump Slider Micro-interaction
    const vacuumSlider = document.getElementById('vacuumSlider');
    const sliderPercentText = document.getElementById('sliderPercentText');
    const pressureValue = document.getElementById('pressureValue');

    if (vacuumSlider && sliderPercentText && pressureValue) {
      vacuumSlider.addEventListener('input', function(e) {
        const val = e.target.value;
        sliderPercentText.innerText = '%' + val;
        // Dynamically shift barometric pressure simulated value
        const dynamicPressure = (1.5 + (val / 100) * 1.8).toFixed(2);
        pressureValue.innerText = dynamicPressure;
      });
    }

    // 4. Primary Trigger Push Button Delight
    const engageBtn = document.getElementById('engageAirlockBtn');
    if (engageBtn) {
      engageBtn.addEventListener('click', function() {
        engageBtn.classList.add('scale-95');
        setTimeout(function() {
          engageBtn.classList.remove('scale-95');
        }, 150);
      });
    }
  })();
</script></main></body></html>

