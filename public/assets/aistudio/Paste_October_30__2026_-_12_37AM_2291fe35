<script>
  let activeBreakerKey = 'k3';
  let isUnlocked = false;

  function selectBreaker(id) {
    if (isUnlocked) return;
    activeBreakerKey = id;

    const keys = ['k1', 'k2', 'k3', 'k4'];
    keys.forEach(k => {
      const el = document.getElementById('btn-' + k);
      if (!el) return;
      if (k === id) {
        el.className = 'breaker-card active-breaker flex flex-col items-center py-3 px-1 rounded-lg bg-primary-container/20 shadow-[0_0_18px_rgba(255,183,3,0.35)] transition-all';
        el.innerHTML = `
          <div class="w-7 h-14 rounded-md bg-primary-container flex flex-col items-center justify-end p-1 shadow-[inset_0_2px_4px_rgba(0,0,0,0.4)]">
            <div class="w-5 h-7 rounded bg-on-primary-container shadow-md flex items-center justify-center">
              <span class="w-1.5 h-1.5 rounded-full bg-primary animate-ping"></span>
            </div>
          </div>
          <span class="font-label-telemetry text-label-telemetry text-primary-container mt-2 font-bold uppercase">${k.toUpperCase()}</span>
        `;
      } else {
        el.className = 'breaker-card flex flex-col items-center py-3 px-1 rounded-lg bg-surface-container-high transition-all active:translate-y-1';
        el.innerHTML = `
          <div class="w-7 h-14 rounded-md bg-surface-container flex flex-col items-center justify-start p-1 shadow-inner">
