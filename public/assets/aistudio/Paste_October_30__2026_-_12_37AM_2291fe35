  (function() {
    let currentFreq = 142.8;
    const readout = document.getElementById('dial-readout');
    const screenLabel = document.getElementById('screen-freq-label');
    const btnDown = document.getElementById('step-down-btn');
    const btnUp = document.getElementById('step-up-btn');
    const lockBtn = document.getElementById('lock-freq-btn');

    function updateDisplay(val) {
      currentFreq = Math.round(val * 10) / 10;
      const formatted = currentFreq.toFixed(1).replace('.', ',');
      if (readout) readout.innerText = formatted;
      if (screenLabel) screenLabel.innerText = formatted + ' MHz';
    }

    if (btnDown) {
      btnDown.addEventListener('click', function() {
        if (currentFreq > 140.0) updateDisplay(currentFreq - 0.1);
      });
    }

    if (btnUp) {
      btnUp.addEventListener('click', function() {
        if (currentFreq < 145.0) updateDisplay(currentFreq + 0.1);
      });
    }

    if (lockBtn) {
      lockBtn.addEventListener('click', function() {
        lockBtn.classList.add('scale-[0.98]');
