        Kilit sağlandı. Kurtarma koordinatları sisteme aktarılıyor.
      </span>
</div>
</div>
</div>
<script>
  (function() {
    const dial = document.getElementById('radar-turntable');
    const pointerGroup = document.getElementById('dial-pointer-group');
    const azimuthDisplay = document.getElementById('azimuth-display');
    const lockBtn = document.getElementById('lock-btn');

    let currentAngle = 275;
    let isDragging = false;

    function updateAngle(clientX, clientY) {
      if (!dial) return;
      const rect = dial.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;
      const rad = Math.atan2(clientY - centerY, clientX - centerX);
      let deg = Math.round(rad * (180 / Math.PI)) + 90;
      if (deg < 0) deg += 360;
      currentAngle = deg;
      if (pointerGroup) pointerGroup.style.transform = `rotate(${deg}deg)`;
      if (azimuthDisplay) azimuthDisplay.textContent = `${deg}°`;
    }

    if (dial) {
      dial.addEventListener('pointerdown', (e) => {
        isDragging = true;
        dial.setPointerCapture(e.pointerId);
        updateAngle(e.clientX, e.clientY);
      });

      dial.addEventListener('pointermove', (e) => {
        if (!isDragging) return;
        updateAngle(e.clientX, e.clientY);
      });

      dial.addEventListener('pointerup', (e) => {
        if (!isDragging) return;
        isDragging = false;
        dial.releasePointerCapture(e.pointerId);
      });

      dial.addEventListener('pointercancel', () => {
        isDragging = false;
      });
    }

    if (lockBtn) {
      lockBtn.addEventListener('click', () => {
        lockBtn.classList.add('scale-95');
        setTimeout(() => lockBtn.classList.remove('scale-95'), 120);
      });
    }
  })();
</script></main></body></html>