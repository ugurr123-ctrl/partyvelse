          <span class="font-label-telemetry text-label-telemetry font-bold">HEDEF İŞARETÇİ: ${isOff ? 'AÇIK' : 'KAPALI'}</span>
        `;
      });
    }

    if (compassSyncBtn) {
      compassSyncBtn.addEventListener('click', () => {
        compassSyncBtn.classList.add('opacity-50');
        compassSyncBtn.querySelector('.material-symbols-outlined').classList.add('animate-spin');
        setTimeout(() => {
          compassSyncBtn.classList.remove('opacity-50');
          compassSyncBtn.querySelector('.material-symbols-outlined').classList.remove('animate-spin');
        }, 1000);
      });
    }
  </script>
</div></main></body></html>