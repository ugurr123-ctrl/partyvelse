<script>
    (function initConsoleControls() {
      let currentVolt = 180;
      const voltEl = document.getElementById('voltageValue');
      const needleEl = document.getElementById('needle');
      const gaugeArc = document.getElementById('gaugeArc');

      function updateVoltage(val) {
        currentVolt = Math.max(140, Math.min(220, val));
        if (voltEl) voltEl.textContent = currentVolt + 'V';
        
        // Map 140V-220V to -50deg to +130deg needle rotation
        const deg = -50 + ((currentVolt - 140) / (220 - 140)) * 180;
        if (needleEl) needleEl.style.transform = 'rotate(' + deg + 'deg)';

        // Offset arc stroke
        const dashOffset = 320 - ((currentVolt - 140) / (220 - 140)) * 180;
        if (gaugeArc) gaugeArc.style.strokeDashoffset = dashOffset;
      }

      const upBtn = document.getElementById('btnVoltUp');
      const downBtn = document.getElementById('btnVoltDown');
      if (upBtn) upBtn.addEventListener('click', () => updateVoltage(currentVolt + 5));
      if (downBtn) downBtn.addEventListener('click', () => updateVoltage(currentVolt - 5));

      // Slider logic
      const slider = document.getElementById('catalystRange');
      const fluidBar = document.getElementById('fluidBar');
      const percentText = document.getElementById('catalystPercentText');
      const thumbInd = document.getElementById('sliderThumbIndicator');

      if (slider) {
        slider.addEventListener('input', (e) => {
          const val = e.target.value;
          if (percentText) percentText.textContent = '%' + val;
          if (fluidBar) fluidBar.style.width = val + '%';
          if (thumbInd) thumbInd.style.left = 'calc(' + val + '% - 12px)';
        });
      }

      // Switch toggle mechanism
      window.toggleSwitch = function(btnId, ledId, statusId, activeLabel, inactiveLabel) {
        const btn = document.getElementById(btnId);
        const led = document.getElementById(ledId);
        const status = document.getElementById(statusId);
        if (!status) return;

        const isCurrentlyActive = status.textContent.trim() === activeLabel;
        if (isCurrentlyActive) {
          status.textContent = inactiveLabel;
          status.className = 'font-label-telemetry text-label-telemetry text-outline font-bold';
          if (led) {
            led.className = 'w-2.5 h-2.5 rounded-full bg-surface-bright';
          }
        } else {
          status.textContent = activeLabel;
          status.className = 'font-label-telemetry text-label-telemetry text-primary font-bold';
          if (led) {
            led.className = 'w-2.5 h-2.5 rounded-full bg-secondary-fixed-dim shadow-[0_0_6px_#00dbe9]';
          }
        }
      };

      // Ignite confirmation micro-feedback
      const ignite = document.getElementById('btnIgnite');
      if (ignite) {
        ignite.addEventListener('click', () => {
          ignite.classList.add('scale-95');
          setTimeout(() => {
            ignite.classList.remove('scale-95');
          }, 150);
        });
      }
    })();
  </script>
