<script>
  (function() {
    let currentPressure = 48;
    const minPressure = 35;
    const maxPressure = 65;
    const pressureLabel = document.getElementById('pressure-val');
    const needle = document.getElementById('gauge-needle');
    const btnInc = document.getElementById('btn-inc');
    const btnDec = document.getElementById('btn-dec');
    const ctaBtn = document.getElementById('activate-valves-btn');
    const tankButtons = document.querySelectorAll('.tank-btn');

    function updateGauge() {
      if (pressureLabel) {
        pressureLabel.textContent = currentPressure;
      }
      if (needle) {
        // Map 35..65 Bar to needle rotation angle
        const baseAngle = ((currentPressure - minPressure) / (maxPressure - minPressure)) * 140;
        needle.style.transform = `rotate(${baseAngle + 20}deg)`;
      }
    }

    if (btnInc) {
      btnInc.addEventListener('click', function() {
        if (currentPressure < maxPressure) {
          currentPressure++;
          updateGauge();
        }
      });
    }

    if (btnDec) {
      btnDec.addEventListener('click', function() {
        if (currentPressure > minPressure) {
          currentPressure--;
          updateGauge();
        }
      });
    }

    tankButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        const isCurrent = this.getAttribute('data-active') === 'true';
        this.setAttribute('data-active', (!isCurrent).toString());
      });
    });

    if (ctaBtn) {
      ctaBtn.addEventListener('click', function() {
        this.classList.add('scale-95');
        setTimeout(() => {
          this.classList.remove('scale-95');
        }, 150);
      });
    }
  })();
</script></main></body></html>

